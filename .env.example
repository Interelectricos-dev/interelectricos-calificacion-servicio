# Variables de Entorno para Intereléctricos - Calificación de Servicio

# URL del proyecto en Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / Public Key de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nombre de la empresa para la interfaz
NEXT_PUBLIC_COMPANY_NAME=Intereléctricos

# Ventana de tiempo (en horas) para evitar calificaciones repetidas inmediatas al mismo asesor
NEXT_PUBLIC_RATING_COOLDOWN_HOURS=3

